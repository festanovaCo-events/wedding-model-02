{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/wedding-model-02/browser",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/invitations-wedding-model-02/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/invitations-wedding-model-02/:file(.*\\..*)",
      "destination": "/:file"
    },
    {
      "source": "/invitations-wedding-model-02/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
