{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/wedding-model-02/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/invitations-wedding-model-02/(.*\\..*)",
      "destination": "/$1"
    },
    {
      "source": "/invitations-wedding-model-02/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
