{
  "framework": null,
  "installCommand": "npm install && node node_modules/esbuild/install.js",
  "buildCommand": "NG_BUILD_MAX_WORKERS=1 npm run build",
  "outputDirectory": "dist/wedding-model-02/browser",
  "rewrites": [
    {
      "source": "/invitations-wedding-model-02/(.*\\..*)",
      "destination": "/$1"
    },
    {
      "source": "/invitations-wedding-model-02/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
