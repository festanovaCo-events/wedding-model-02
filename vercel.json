{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "rewrites": [
    {
      "source": "/invitations-wedding-model-02/(.*\\..*)",
      "destination": "/$1"
    },
    {
      "source": "/invitations-wedding-model-02/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
